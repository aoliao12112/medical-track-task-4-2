# 复制为 web/backend/.env；真实文件已被 .gitignore 排除，禁止提交密钥。
# 每名队员只在本地副本中填写同一个团队 Key。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=360
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=18000
DEEPSEEK_CHUNK_MAX_OUTPUT_TOKENS=30000
DEEPSEEK_PAIN_MAX_OUTPUT_TOKENS=10000
DEEPSEEK_CARE_MAX_OUTPUT_TOKENS=12000
DEEPSEEK_RECOMMENDATION_INTENT_MAX_OUTPUT_TOKENS=6000
# 第三问温度指引与第四问推荐意图共用；false 时两个用途均禁止调用外部模型。
EXTERNAL_MODEL_PROCESSING_ENABLED=true

# 第四问 V2：只发送病种与推荐地区用于公开网页发现，不发送病例正文。
# 搜索结果仅用于定位，正式证据必须来自随后抓取的权威原始页面。
QUALITY_DYNAMIC_DISCOVERY_ENABLED=true
QUALITY_DISCOVERY_TIMEOUT_SECONDS=8
# auto 优先使用已配置的 Serper；无 Key 时依次使用搜狗网页检索和 Bing RSS。
QUALITY_SEARCH_PROVIDER=auto
QUALITY_SEARCH_API_KEY=

# 长病例参数：团队成员应保持一致，避免同一病例得到不同分块结果。
LONG_CASE_PAGE_THRESHOLD=8
LONG_CASE_CHARACTER_THRESHOLD=24000
LONG_CASE_CHUNK_MAX_PAGES=6
LONG_CASE_CHUNK_MAX_CHARACTERS=18000
LONG_CASE_CHUNK_MAX_OCR_BLOCKS=600
LONG_CASE_CACHE_ENABLED=true

# 手机预览默认自动探测局域网IP；仅在自动探测不正确时填写。
MOBILE_PREVIEW_HOST=
MOBILE_PREVIEW_GATEWAY_PORT=8766
